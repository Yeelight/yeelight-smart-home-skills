{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yeelight-wellness-schedule-v1",
  "title": "Yeelight Wellness Host Schedule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skill", "enabled", "invocationMode", "schedule", "homeBinding", "location", "rule", "scope", "executionBounds", "fallback"],
  "properties": {
    "schemaVersion": {"const": "yeelight-wellness-schedule-v1"},
    "skill": {"const": "yeelight-wellness-lighting"},
    "enabled": {"type": "boolean"},
    "invocationMode": {"const": "scheduled"},
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localExpression", "timezone", "triggerWindow"],
      "properties": {
        "localExpression": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^(?!.*[;&|$`(){}<>])[^\\r\\n<>]{1,120}$"},
        "timezone": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)+$"},
        "triggerWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
            "end": {"type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
          }
        }
      }
    },
    "homeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeHomeRef", "region", "profileRef"],
      "properties": {
        "runtimeHomeRef": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]{1,160}$"},
        "homeName": {"type": "string", "maxLength": 80, "pattern": "^(?!.*[;&|$`(){}<>])[^\\r\\n<>]{0,80}$"},
        "region": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9_-]{1,32}$"},
        "profileRef": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]{1,160}$"}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "timezone"],
      "properties": {
        "city": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?!.*[;&|$`(){}<>])[^\\r\\n<>]{1,80}$"},
        "region": {"type": "string", "maxLength": 40, "pattern": "^(?!.*[;&|$`(){}<>])[^\\r\\n<>]{0,40}$"},
        "timezone": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)+$"},
        "holidayRegion": {"type": "string", "maxLength": 32, "pattern": "^[A-Za-z0-9_-]{0,32}$"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipePreferences", "userPrinciples", "publicContextNeeds"],
      "properties": {
        "recipePreferences": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
        "userPrinciples": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^(?!.*[;&|$`(){}<>])[^\\r\\n<>]{1,100}$"}},
        "publicContextNeeds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "optional"],
          "properties": {
            "required": {"type": "array", "maxItems": 16, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}},
            "optional": {"type": "array", "maxItems": 16, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"}}
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "protectedTargets"],
      "properties": {
        "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?!.*[;&|$`(){}<>])[^\\r\\n<>]{1,80}$"}},
        "protectedTargets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?!.*[;&|$`(){}<>])[^\\r\\n<>]{1,80}$"}}
      }
    },
    "executionBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedActions", "allowedPowerTransitions", "maxWritePhases", "unrelatedScope"],
      "properties": {
        "allowedActions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["power", "brightness", "colorTemperature", "color", "supportedEffect"]}},
        "allowedPowerTransitions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["on", "off"]}},
        "maxWritePhases": {"const": 1},
        "unrelatedScope": {"const": "exclude"}
      }
    },
    "fallback": {"enum": ["skip", "context-light", "ask-next-interaction"]}
  }
}
