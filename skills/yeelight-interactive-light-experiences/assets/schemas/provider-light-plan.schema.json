{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yeelight-interactive-light-experiences/provider-light-plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "m", "p"],
  "properties": {
    "v": { "type": "integer", "enum": [1] },
    "m": { "type": "string", "enum": ["flow"] },
    "p": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["d", "t", "q"],
        "properties": {
          "d": { "type": "integer", "minimum": 700, "maximum": 2000 },
          "t": { "type": "integer", "minimum": 400, "maximum": 12000 },
          "q": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["h", "s", "b"],
              "properties": {
                "h": { "type": "integer", "minimum": 0, "maximum": 359 },
                "s": { "type": "integer", "minimum": 0, "maximum": 100 },
                "b": { "type": "integer", "minimum": 1, "maximum": 85 }
              }
            }
          }
        }
      }
    }
  }
}
